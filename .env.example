# CloudEye configuration. Copy to `.env` and edit: `cp .env.example .env`.
#
# Every variable below is read somewhere in this repository. Each entry says WHAT it is,
# WHERE to get the value, and whether it is REQUIRED or OPTIONAL. Anything marked OPTIONAL
# has a working default in code and can be left as-is or deleted.
#
# `.env` is gitignored. Never put a real key in this file - see docs/DEPLOY.md for how
# production layers secrets on top with systemd's EnvironmentFile=.
#
# Machine-local paths: the defaults below point into `var/`, a gitignored directory where
# you mount or symlink the out-of-repo trees (uploads, scratch, assets). docs/INSTALL.md
# explains the layout.


# =============================================================================
# Backend service - read by app/config.py (pydantic-settings; field name upper-cased)
# =============================================================================

# REQUIRED. SQLAlchemy async URL for PostgreSQL 16. Create the role and database first:
#   sudo -u postgres createuser robot --pwprompt && sudo -u postgres createdb robotdb -O robot
DATABASE_URL=postgresql+asyncpg://robot:robot@127.0.0.1:5432/robotdb

# REQUIRED in production, OPTIONAL locally. Where uploaded videos and per-scene artifact
# directories are written. Must be writable by the API and the worker. Production uses a
# dedicated data volume such as var/uploads; the default is a repo-local `var/uploads`.
UPLOAD_DIR=./var/uploads

# OPTIONAL. Largest accepted upload, in bytes. Default 2 GiB.
MAX_UPLOAD_BYTES=2147483648

# REQUIRED. Redis for the arq job queue. `apt-get install redis-server` gives you this URL.
REDIS_URL=redis://127.0.0.1:6379/0

# OPTIONAL. Points kept in the exported scene_points.glb. Matches the frontend's render
# budget (frontend/src/lib/pointcloudDecimate.ts). Default 400000.
GLB_MAX_POINTS=400000

# OPTIONAL. Keep each frame's per-view artifacts (per_view/*.npz, per_view_png/) in the
# fetched scene directory instead of discarding them. Real disk cost per scene. Default false.
RETAIN_PER_VIEW_ARTIFACTS=false

# OPTIONAL. Run the bounded RANSAC plane-position projection on the aligned cloud
# (gpu/plane_regularize.py). Validated only on a spike scene. Default false.
REGULARIZE_PLANES=false

# OPTIONAL. Where the nvblox layer packs live - one directory per reconstructed scene,
# each holding that scene's band layer and unobserved mask. Read-only, produced by the
# pipeline/ driver (its --scenes-out-root), not by this service. Default ./var/frontend_layers.
FRONTEND_LAYERS_DIR=./var/frontend_layers


# =============================================================================
# GPU orchestration - the 7-stage gpu/ pipeline, driven over SSH by app/services/gpu_client.py
# =============================================================================

# REQUIRED to process video. An ssh host alias you define in ~/.ssh/config pointing at the
# rented GPU instance. Leave GPU_SSH_PORT/GPU_SSH_KEY empty to let ssh use that file.
GPU_SSH_HOST=gpu
GPU_SSH_PORT=
GPU_SSH_KEY=

# OPTIONAL. Writable workspace on the GPU instance. Default /workspace.
GPU_WORKSPACE_DIR=/workspace

# OPTIONAL. Per-job wall-clock ceiling, and how often status.json is polled over ssh.
JOB_TIMEOUT_SEC=3600
GPU_POLL_INTERVAL_SEC=15

# OPTIONAL. Keyframe extraction: sampling rate and hard cap on frames per video.
KEYFRAME_FPS=2.0
MAX_KEYFRAMES=200

# OPTIONAL, read on the GPU box by gpu/run_pipeline.sh. Per-stage timeout in seconds.
# Default 900.
STAGE_TIMEOUT=900


# =============================================================================
# Semantics and command parsing - OpenRouter is the default provider
# =============================================================================

# REQUIRED for the object-vocabulary stage and the chat command box; both fail loudly
# without it rather than silently degrading. Get one at https://openrouter.ai/keys.
# Never commit a real key: production supplies it with systemd EnvironmentFile=
# (see deploy/video-worker.service), and run_api.sh sources $HOME/.secrets/openrouter.env.
OPENROUTER_API_KEY=

# OPTIONAL. Text-only model that parses "go to the bed" into {action, target, destination}.
OPENROUTER_MODEL_COMMAND=nvidia/nemotron-3-nano-30b-a3b

# OPTIONAL. Vision model that builds the per-scene object vocabulary from keyframes.
# This is the semantics default - see docs/MODELS.md for why GLM and not Gemma.
OPENROUTER_MODEL_VISION=z-ai/glm-5.3-flash

# OPTIONAL. API base. Change only for a proxy or a self-hosted gateway.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OPTIONAL, read on the GPU box by gpu/stage_vocab.py. Overrides the vision model for one
# job. The backend normally passes this through params.json instead of the environment.
OPENROUTER_MODEL=


# =============================================================================
# Vertex AI - the alternative semantics provider. OPTIONAL; see docs/GOOGLE_CLOUD.md
# =============================================================================

# OPTIONAL, read by scripts/msa/trellis_client.py. Where the TRELLIS.2 source checkout
# lives on the GPU box, for the MSA image-to-mesh stage. Default /workspace/trellis-src.
TRELLIS_SRC_DIR=


# OPTIONAL. Your Google Cloud project id. Only needed when a video's vocab_provider is
# "vertex". There is no API key: auth is Application Default Credentials
# (`gcloud auth application-default login`). Leave unset to use OpenRouter only.
GCP_PROJECT_ID=

# OPTIONAL, and normally NOT set by hand. A short-lived OAuth access token, minted by
# app/services/vertex_auth.py and pushed to the GPU box as a per-job secret. Set it
# yourself only when running gpu/stage_vocab.py standalone.
VERTEX_ACCESS_TOKEN=


# =============================================================================
# Robot / pathfinding
# =============================================================================

# OPTIONAL. Planner footprint radius in metres. 0.10 matches ROBOTIS's own Nav2 config for
# the TurtleBot3 Burger and the bundled mesh (0.1045 m). See app/config.py before changing:
# inflate() takes ceil(r / 0.05), so 0.11 costs a whole extra grid cell of clearance.
ROBOT_RADIUS_M=0.10

# OPTIONAL. Metres per second, used only to turn a route length into an ETA.
ROBOT_SPEED_MPS=0.5


# =============================================================================
# pipeline/ - the resumable nvblox driver that rents GPU boxes on vast.ai
# See docs/GPU_VAST.md. Everything here is OPTIONAL; absent means "spend nothing".
# =============================================================================

# The unattended worker's replacement for the pipeline/ARMED file. Must be exactly "1"
# for the worker to rent anything. Absent or any other value = dry run: the driver runs
# and writes status.json, makes no vast.ai call, and spends nothing. Renting is opt-in.
PIPELINE_WORKER_ENABLED=

# The day's ceiling in USD, accumulated in pipeline/state/daily_spend.json across restarts
# and checked BEFORE any vast.ai call. The per-run --max-usd is clamped to what is left.
PIPELINE_DAILY_USD=

# Set to 1 to force dry-run mode regardless of ARMED. Presence alone is enough.
PIPELINE_DRY_RUN=

# Interpreter for the CPU-only stages (PACK, LAYERS, REACH, EXPORT), which need open3d and
# usd-core - not this repo's own .venv. Default ~/venvs/o3d-cpu/bin/python; pipeline/cpu_env.py
# prints the exact rebuild command if it is missing.
PIPELINE_CPU_PYTHON=

# Where hand-driven MapAnything pass-A bundles live, searched by the original upload
# filename stem. Default ./var/pass_a. See docs/GPU_VAST.md - pass A is manual today.
PIPELINE_PASS_A_ROOT=

# Set to "0" to run the colourless path the pipeline produced before 2026-09-10.
PIPELINE_COLOR=

# Set to 1 to leave the rented box running after a job instead of stopping it. Costs money.
PIPELINE_KEEP_BOX_UP=

# Roots the offline suite (pipeline/tests/run_tests.py) reads its fixtures from. It needs
# a packed depth stack, an nvblox output fixture and a pass-A bundle; they are not in git.
PIPELINE_TEST_FIXTURES=
PIPELINE_TEST_VIDEO=


# =============================================================================
# pipeline/steps/pull_loop.sh - the VPS-side per-job pull loop
# =============================================================================

# Where the loop writes, which box it pulls from, the ssh port, the poll interval, and the
# log directory. All OPTIONAL with defaults in the script.
BASE=
GPU_HOST=
GPU_PORT=
INTERVAL=
LOGS=


# =============================================================================
# Frontend (Vite) - the only variable the frontend reads
# =============================================================================

# OPTIONAL. Backend the dev server and `vite preview` proxy /api to. Default
# http://127.0.0.1:8000. Point it at a throwaway backend to avoid touching production.
# The SPA itself always calls a same-origin /api prefix; there is no runtime base URL.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000


# =============================================================================
# run_api.sh - dev entrypoint only
# =============================================================================

# OPTIONAL. Port uvicorn binds on 127.0.0.1, and an alternative path to the file holding
# OPENROUTER_API_KEY. Defaults: 8000 and $HOME/.secrets/openrouter.env.
API_PORT=8000
CLOUDEYE_SECRETS_FILE=


# =============================================================================
# deploy/install_isaacsim_gpu.sh - Isaac Sim provisioning on the GPU box. UNVERIFIED,
# never executed. Only relevant if you run that script. All OPTIONAL.
# =============================================================================

# Install root (must be a real mounted volume), the release to fetch, the downloaded zip's
# name, the free-space floor in GB, whether to keep the zip, the code-editor port, and the
# escape hatch that lets the volume resolve to the same device as /.
VOLUME=
ISAAC_SIM_VERSION=
ISAAC_SIM_ZIP_URL=
ZIP_NAME=
MIN_FREE_GB=
KEEP_ISAACSIM_ZIP=
CODE_EDITOR_PORT=
ALLOW_ROOT_VOLUME=
