# API + worker image. WRITTEN, NOT EXECUTED - see docs/INSTALL.md.
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg openssh-client rsync curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /app
# Lockfile first so a source edit does not invalidate the dependency layer.
COPY pyproject.toml uv.lock .python-version ./
RUN uv sync --frozen --no-dev

COPY alembic.ini ./
COPY alembic/ ./alembic/
COPY app/ ./app/
COPY gpu/ ./gpu/
COPY pipeline/ ./pipeline/
COPY scripts/ ./scripts/

ENV PATH="/app/.venv/bin:$PATH"
EXPOSE 8000
# Loopback-only is enforced by the compose port binding, not here.
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
